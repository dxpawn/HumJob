# HumJob local config. Copy this file to `.env` and fill in your key.
# `.env` is gitignored and read only server-side (never sent to the browser).
# It is read per request, so you can add the key without restarting the server.
#
# Used by the Sing-Along "Get coaching" feature (mouthtranscriber/coach.py), which sends
# ONLY the numeric take summary to the LLM API - never your audio or recording.

# Required for coaching. Get one from your DeepSeek account.
DEEPSEEK_API_KEY=

# The chat model to use. Change this to switch models without touching code.
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI-compatible base URL (a /chat/completions path is appended).
DEEPSEEK_BASE_URL=https://api.deepseek.com
