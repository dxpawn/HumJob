# HumJob local config. Copy this file to `.env` and fill in your key.
# `.env` is gitignored and read only server-side (never sent to the browser).
# It is read per request, so you can add the key without restarting the server.
#
# Used by the opt-in LLM features - Sing-Along "Get coaching" (mouthtranscriber/coach.py),
# the hub "Get a practice plan" (mouthtranscriber/progress_coach.py), Manual mode's "Ask"
# edit and "Reorganize" (edit_nl.py / simplify.py), and "Reharmonize" (reharm.py) - which
# send ONLY a compact text or numeric summary to the LLM API, never your audio, recording,
# or filenames. The shared transport lives in mouthtranscriber/llm.py.

# Required for coaching. Get one from your DeepSeek account.
DEEPSEEK_API_KEY=

# The chat model to use. Change this to switch models without touching code.
DEEPSEEK_MODEL=deepseek-flash

# OpenAI-compatible base URL (a /chat/completions path is appended).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional per-feature model overrides. deepseek-flash is a REASONING model: it spends
# hidden "thinking" tokens before answering, which is fine for a coaching paragraph but can feel
# slow for the structured features (a Manual-mode "Ask" edit or "Reorganize", a Reharmonize which
# took ~30s in testing). That hidden thinking is also why a feature can occasionally fail with
# "the model hit its token limit before writing a reply" even on a short melody: the reasoning
# burned the whole output budget before the JSON. Setting these to a faster NON-REASONING chat
# model (if your DeepSeek plan offers one) both speeds those up and avoids that error, since a
# non-reasoning model spends no hidden tokens. Each falls back to DEEPSEEK_MODEL if unset.
# DEEPSEEK_EDIT_MODEL=      # used by Manual "Ask" and "Reorganize"
# DEEPSEEK_CHORD_MODEL=     # used by "Reharmonize"
